# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real secrets. This file (.env.example) IS safe to commit.

# --- Etsy data source ---
# "mock" | "real". Defaults to mock automatically whenever ETSY_API_KEY is unset,
# so this only needs to be set explicitly to force a mode.
ETSY_DATA_SOURCE=mock

# Etsy Open API v3 credentials (leave blank until the developer app is approved — decision 9)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# --- AI connector (Step 2 classification + candidate generation) ---
# Groq (Llama) zero-setup default — decision 14. Get a free key at https://console.groq.com
GROQ_API_KEY=

# --- AI connector (Step 9 cover generation) ---
# Google Gemini API — standard "Nano Banana 2" tier (gemini-3.1-flash-image), confirmed
# per phase7-requirements.md §3.1, not Lite or Pro. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- AI connector (Step 10 copywriting) ---
# Groq is the default (COPYWRITING_AI_PROVIDER=groq or unset) — same GROQ_API_KEY above.
# Real, scoped Claude/OpenAI wrappers exist (decision 13, phase8-requirements.md) if you
# want this specific step's writing on a paid provider instead. Neither is live-verified
# in this build (a disclosed gap) — only flip this once you have a real key for it.
COPYWRITING_AI_PROVIDER=groq
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
